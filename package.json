    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=22.13"
  },
  "lint-staged": {
    "*.{ts,tsx,js}": [
